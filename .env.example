# JSW Coil OCR — Environment Variables
# Copy this file to .env and fill in your values
# Run: copy .env.example .env   (Windows)

# ── Gemini API Keys ────────────────────────────────────────────────────────
# Get free key at: https://aistudio.google.com/apikey
# Key 1 is required. Keys 2 and 3 are optional backups.
# Each key = 1500 req/day free. 3 keys = 4500 req/day.
# If a key hits daily limit, app auto-rotates to next key.

GEMINI_API_KEY_1=your_primary_key_here
GEMINI_API_KEY_2=your_backup_key_here
GEMINI_API_KEY_3=your_third_key_here

# ── Server Settings ────────────────────────────────────────────────────────
PORT=8000

# ── MES/SAP Integration (optional) ────────────────────────────────────────
# When worker confirms a coil ID, app will POST to this URL.
# Leave blank if not using MES/SAP integration.
# MES_WEBHOOK_URL=http://your-mes-server/api/coil-scan
MES_WEBHOOK_URL=
